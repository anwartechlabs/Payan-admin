# Browser key for the Payan Admin dashboard. Enable Maps JavaScript API and
# restrict this key to the dashboard's HTTPS origins and localhost development.
# Android- and iOS-restricted keys cannot authorize a browser map.
GOOGLE_MAPS_WEB_API_KEY=your_google_maps_web_api_key_here

# Google Cloud API key with Maps SDK for Android enabled.
# Restrict the key to package com.payan.customer and the SHA-1 fingerprint
# of each signing certificate that will build the app. This value is injected
# into the native Android manifest at build time and is not used by Expo Go.
GOOGLE_MAPS_ANDROID_API_KEY=your_google_maps_android_api_key_here

# Optional Google Maps SDK for iOS key. Without it, iOS keeps the Apple Map
# preview and does not draw Google Routes content over that non-Google map.
GOOGLE_MAPS_IOS_API_KEY=your_google_maps_ios_api_key_here

# OAuth 2.0 Web application client ID used to request and verify Google ID
# tokens. OAuth client IDs identify the app and are not API keys or secrets.
GOOGLE_AUTH_WEB_CLIENT_ID=your_web_oauth_client_id.apps.googleusercontent.com

# OAuth 2.0 iOS client ID for bundle identifier com.payan.customer. Android
# also needs an Android OAuth client registered for com.payan.customer and
# each signing SHA-1, but that Android client ID is not copied into this file.
GOOGLE_AUTH_IOS_CLIENT_ID=your_ios_oauth_client_id.apps.googleusercontent.com

# Separate server-side key with Routes API, Places API (New), and Geocoding API
# enabled. Do not expose this key in EXPO_PUBLIC variables or the client bundle.
# Restrict production usage to the server's egress IP addresses and only those
# three APIs. The legacy variable name is kept for deployment compatibility.
GOOGLE_ROUTES_API_KEY=your_server_side_google_routes_api_key_here

# Public HTTPS origin of the deployed Expo server/API routes for production
# native builds. Local development automatically uses the Expo dev server.
# Add Eas Route in Prod
ROUTING_SERVER_ORIGIN=https://your-routing-server.example.com

# GOOGLE MAPS IN WEB
GOOGLE_MAPS_WEB_API_KEY=AIzaSyYourActualApiKeyHere
